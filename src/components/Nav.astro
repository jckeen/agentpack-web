---
import ThemeToggle from './ThemeToggle.astro';
const repo = 'https://github.com/jckeen/agent-pack';
---
<header class="sticky top-0 z-40 border-b border-[var(--border)] bg-[var(--bg)]/85 backdrop-blur">
  <nav class="mx-auto flex h-16 max-w-6xl items-center gap-6 px-5" aria-label="Primary">
    <a href="/" class="flex items-center gap-2.5 font-mono text-sm font-semibold tracking-tight">
      <span class="grid h-7 w-7 place-items-center rounded-md border border-[var(--accent)] text-accent" aria-hidden="true">▣</span>
      AgentPack
    </a>
    <div class="ml-auto hidden items-center gap-6 text-sm text-soft md:flex">
      <a href="#how" class="transition-colors hover:text-accent">How it works</a>
      <a href="#quickstart" class="transition-colors hover:text-accent">Quickstart</a>
      <a href="#governance" class="transition-colors hover:text-accent">Governance</a>
      <a href="#portability" class="transition-colors hover:text-accent">Portability</a>
      <a href={`${repo}/tree/master/docs`} class="transition-colors hover:text-accent">Docs</a>
    </div>
    <div class="ml-auto flex items-center gap-3 md:ml-0">
      <a
        href={repo}
        aria-label="Star AgentPack on GitHub"
        class="inline-flex items-center gap-2 rounded-md border border-[var(--border)] px-3 py-1.5 text-sm text-soft transition-colors hover:text-accent hover:border-[var(--accent)]"
      >
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"></path></svg>
        <span class="hidden sm:inline">Star</span>
      </a>
      <ThemeToggle />
    </div>
  </nav>
</header>
